NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-base64-32

KEYCLOAK_ISSUER=http://localhost:8081/realms/buscador-empleo
KEYCLOAK_CLIENT_ID=buscador-empleo-frontend

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Si AUTH_ENABLED=false en el backend (modo desarrollo), la UI puede
# omitir el login y llamar a la API sin token. Ver src/auth/auth.ts.
NEXT_PUBLIC_AUTH_ENABLED=true
